{
  "name": "tscart",
  "version": "1.0.9",
  "private": true,
  "type": "module",
  "description": "TSCART — thoughtfully chosen home essentials",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "setup": "node scripts/setup.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "build": "node scripts/migrate-preview-payload.js && esbuild client/blob-upload-entry.js --bundle --format=iife --target=es2020 --outfile=public/js/blob-upload.js",
    "migrate:vercel": "node --env-file-if-exists=.env.local scripts/migrate-to-vercel.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
