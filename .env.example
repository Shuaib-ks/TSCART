# Node.js 24.x. Run npm run setup, then npm start. No npm install needed.
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
NODE_ENV=development
# demo: COD test orders only. live: real COD and configured Razorpay payments.
STORE_MODE=demo
DATA_DIR=./data
# Used ONLY when creating the first admin. Change password in Admin > Settings.
ADMIN_EMAIL=tscart@gmai.com
ADMIN_INITIAL_PASSWORD=TSCART123
# Comma-separated country-format PIN codes. Blank means all valid Indian PINs.
SERVICEABLE_PINCODES=
# Only enable when your trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

# Dashboard > Account & Settings > API Keys. Keep secrets on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Test keys work in live store mode for staging. Set REQUIRE_LIVE_KEYS=true for real sales.
REQUIRE_LIVE_KEYS=false

# WhatsApp Cloud API, a separate API sender number, and an approved template.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=tscart_order_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TO=917736681091
